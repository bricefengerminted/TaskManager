#!/bin/bash
# ──────────────────────────────────────────────
# TaskManager.app launcher
#
# If app window exists: bring it to front.
# If servers running but no window: open a new --app window.
# If nothing running: start servers via start.sh.
# ──────────────────────────────────────────────

# ── Fix PATH for .app / Finder / Stream Deck context ──
for p in /opt/homebrew/bin /usr/local/bin "$HOME/.nvm/current/bin" "$HOME/.fnm/aliases/default/bin" "$HOME/.volta/bin"; do
  [ -d "$p" ] && export PATH="$p:$PATH"
done
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh" 2>/dev/null
fi

APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_DIR="$APP_DIR"
FRONTEND_PORT=5173

# ── Try to bring existing window to front ──
if "$PROJECT_DIR/bring-to-front.sh"; then
  exit 0
fi

# ── No window found — start servers if not running ──
if ! /usr/bin/curl -s --max-time 2 "http://localhost:$FRONTEND_PORT" > /dev/null 2>&1; then
  if [ -f "$PROJECT_DIR/start.sh" ]; then
    open -a Terminal "$PROJECT_DIR/start.sh"
  else
    osascript -e "display alert \"TaskManager\" message \"Could not find start.sh in $PROJECT_DIR.\""
    exit 1
  fi
fi
