#!/bin/bash
# TaskManager.app launcher
# Opens Terminal running start.sh (which opens Chrome in --app mode)

# Resolve the project root from the .app bundle location
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_DIR="$APP_DIR"

if [ -f "$PROJECT_DIR/start.sh" ]; then
  open -a Terminal "$PROJECT_DIR/start.sh"
else
  osascript -e "display alert \"TaskManager\" message \"Could not find start.sh in $PROJECT_DIR. Make sure the TaskManager.app is in your TaskManager project folder.\""
fi
