#!/bin/bash
# TaskManager.app launcher
# If already running, brings the existing window to front.
# Otherwise starts the app normally.

# ── Fix PATH for .app / Finder / Stream Deck context ──
# When launched from Finder or Stream Deck, PATH is just /usr/bin:/bin:/usr/sbin:/sbin.
# We need Homebrew, nvm, fnm, etc. on the PATH for node/npm/curl to be found.
for p in /opt/homebrew/bin /usr/local/bin "$HOME/.nvm/current/bin" "$HOME/.fnm/aliases/default/bin" "$HOME/.volta/bin"; do
  [ -d "$p" ] && export PATH="$p:$PATH"
done
# Source nvm if available (sets PATH to the active node version)
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh" 2>/dev/null
fi

# Resolve the project root from the .app bundle location
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_DIR="$APP_DIR"

FRONTEND_PORT=5173

# Check if the app is already running by testing the frontend port
if /usr/bin/curl -s --max-time 2 "http://localhost:$FRONTEND_PORT" > /dev/null 2>&1; then
  # App is already running — bring the window to front
  "$PROJECT_DIR/bring-to-front.sh"
  exit 0
fi

# Not running yet — start it
if [ -f "$PROJECT_DIR/start.sh" ]; then
  open -a Terminal "$PROJECT_DIR/start.sh"
else
  osascript -e "display alert \"TaskManager\" message \"Could not find start.sh in $PROJECT_DIR. Make sure the TaskManager.app is in your TaskManager project folder.\""
fi
