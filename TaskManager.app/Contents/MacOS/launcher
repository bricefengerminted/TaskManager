#!/bin/bash
# ──────────────────────────────────────────────
# TaskManager.app launcher (persistent)
#
# This process stays alive so the app behaves like a real macOS app:
#   - Dock icon persists while running
#   - Right-click → Quit kills the servers
#   - Clicking the Dock icon again brings the window to front
#
# How it works:
#   - First launch: starts servers, stays alive
#   - Subsequent clicks: detect the running instance via PID file,
#     signal it (USR1) to bring the window to front, then exit
# ──────────────────────────────────────────────

# ── Fix PATH for .app / Finder / Stream Deck context ──
for p in /opt/homebrew/bin /usr/local/bin "$HOME/.nvm/current/bin" "$HOME/.fnm/aliases/default/bin" "$HOME/.volta/bin"; do
  [ -d "$p" ] && export PATH="$p:$PATH"
done
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh" 2>/dev/null
fi

# Resolve the project root from the .app bundle location
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_DIR="$APP_DIR"
PIDFILE="/tmp/taskmanager-app.pid"
FRONTEND_PORT=5173

# ── Check if another launcher instance is already running ──
if [ -f "$PIDFILE" ]; then
  EXISTING_PID=$(/bin/cat "$PIDFILE")
  if kill -0 "$EXISTING_PID" 2>/dev/null; then
    # Already running — signal it to bring window to front
    kill -USR1 "$EXISTING_PID"
    exit 0
  fi
  # Stale PID file — remove and continue as primary
  rm -f "$PIDFILE"
fi

# ── We are the primary instance ──
echo $$ > "$PIDFILE"

# Handle USR1: bring window to front (triggered by Dock re-click)
trap '"$PROJECT_DIR/bring-to-front.sh" &' USR1

# Handle TERM/INT: Quit from Dock or Ctrl+C
cleanup() {
  kill $(/usr/bin/lsof -ti :$FRONTEND_PORT) 2>/dev/null
  kill $(/usr/bin/lsof -ti :3001) 2>/dev/null
  rm -f "$PIDFILE"
  exit 0
}
trap cleanup TERM INT

# ── Start or focus ──
if /usr/bin/curl -s --max-time 2 "http://localhost:$FRONTEND_PORT" > /dev/null 2>&1; then
  # Servers already running — just bring the window to front
  "$PROJECT_DIR/bring-to-front.sh" &
else
  # Start servers
  if [ -f "$PROJECT_DIR/start.sh" ]; then
    open -a Terminal "$PROJECT_DIR/start.sh"
  else
    osascript -e "display alert \"TaskManager\" message \"Could not find start.sh in $PROJECT_DIR.\""
    rm -f "$PIDFILE"
    exit 1
  fi
fi

# ── Stay alive so the Dock icon persists and Quit works ──
while true; do
  sleep 1 &
  wait $!  # wait is interruptible by signals, unlike sleep
done
