#!/bin/bash
# TaskManager.app launcher
# If already running, brings the existing window to front.
# Otherwise starts the app normally.

# Resolve the project root from the .app bundle location
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_DIR="$APP_DIR"

FRONTEND_PORT=5173

# Check if the app is already running by testing the frontend port
if curl -s "http://localhost:$FRONTEND_PORT" > /dev/null 2>&1; then
  # App is already running — bring the Chrome app window to front
  "$PROJECT_DIR/bring-to-front.sh" 2>/dev/null
  exit 0
fi

# Not running yet — start it
if [ -f "$PROJECT_DIR/start.sh" ]; then
  open -a Terminal "$PROJECT_DIR/start.sh"
else
  osascript -e "display alert \"TaskManager\" message \"Could not find start.sh in $PROJECT_DIR. Make sure the TaskManager.app is in your TaskManager project folder.\""
fi
