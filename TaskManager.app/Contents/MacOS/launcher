#!/bin/bash
# ──────────────────────────────────────────────
# TaskManager.app launcher
#
# Fire-and-forget: starts servers if needed, or brings the existing
# window to front, then exits immediately. No persistent process,
# no Dock icon, no bouncing.
# ──────────────────────────────────────────────

# ── Fix PATH for .app / Finder / Stream Deck context ──
for p in /opt/homebrew/bin /usr/local/bin "$HOME/.nvm/current/bin" "$HOME/.fnm/aliases/default/bin" "$HOME/.volta/bin"; do
  [ -d "$p" ] && export PATH="$p:$PATH"
done
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  . "$NVM_DIR/nvm.sh" 2>/dev/null
fi

# Resolve the project root from the .app bundle location
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PROJECT_DIR="$APP_DIR"
FRONTEND_PORT=5173
TARGET_URL="localhost:$FRONTEND_PORT"

# ── If servers are already running, bring window to front and exit ──
if /usr/bin/curl -s --max-time 2 "http://localhost:$FRONTEND_PORT" > /dev/null 2>&1; then

  # Try AppleScript to focus the exact Chrome tab (works without Accessibility permissions)
  RESULT=$(osascript <<EOF 2>&1
tell application "Google Chrome"
    repeat with w from 1 to (count of windows)
        repeat with t from 1 to (count of tabs of window w)
            if URL of tab t of window w contains "$TARGET_URL" then
                set active tab index of window w to t
                set index of window w to 1
                activate
                return "ok"
            end if
        end repeat
    end repeat
    return "not_found"
end tell
EOF
  )

  case "$RESULT" in
    "ok")
      ;; # Tab found and focused
    "not_found")
      open -a "Google Chrome" "http://$TARGET_URL"
      ;;
    *)
      # AppleScript failed (permissions or Chrome not running) — fallback
      open "http://$TARGET_URL"
      ;;
  esac

  exit 0
fi

# ── Servers not running — start them ──
if [ -f "$PROJECT_DIR/start.sh" ]; then
  open -a Terminal "$PROJECT_DIR/start.sh"
else
  osascript -e "display alert \"TaskManager\" message \"Could not find start.sh in $PROJECT_DIR.\""
  exit 1
fi
