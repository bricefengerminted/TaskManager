{
  "name": "taskmanager-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "confluence": "ts-node src/scripts/confluence-plan.ts",
    "doc-check": "ts-node --transpile-only src/scripts/doc-check.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.6.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.30.8",
    "express": "^4.18.3",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.20.14",
    "supertest": "^6.3.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3",
    "vitest": "^1.6.0"
  }
}
